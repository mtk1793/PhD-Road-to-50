\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Privacy–accuracy trade-off under differential privacy. Detection accuracy (blue, left axis) and DLG gradient inversion Pearson correlation $\rho $ (red, right axis; lower = more private) as $\epsilon $ varies. The $\epsilon {=}2.0$ operating point (green dashed) achieves 97.3\% accuracy with $\rho {=}0.13$ (near-random reconstruction), satisfying both performance and privacy requirements.}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:privacy}{{3}{8}{Privacy–accuracy trade-off under differential privacy. Detection accuracy (blue, left axis) and DLG gradient inversion Pearson correlation $\rho $ (red, right axis; lower = more private) as $\epsilon $ varies. The $\epsilon {=}2.0$ operating point (green dashed) achieves 97.3\% accuracy with $\rho {=}0.13$ (near-random reconstruction), satisfying both performance and privacy requirements}{figure.3}{}}
