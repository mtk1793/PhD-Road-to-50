\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces SHAP-based attack explainability. (a) Top-10 EV feature importance: compromised EVs (red) receive SHAP values $>0.6$, well above the detection threshold. (b) Attack localization on feeder topology: compromised EVs cluster around transformer T-47, confirming spatial propagation via shared electrical path—a pattern detectable only by the graph-aware GC-LSTM architecture.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:shap}{{4}{9}{SHAP-based attack explainability. (a) Top-10 EV feature importance: compromised EVs (red) receive SHAP values $>0.6$, well above the detection threshold. (b) Attack localization on feeder topology: compromised EVs cluster around transformer T-47, confirming spatial propagation via shared electrical path—a pattern detectable only by the graph-aware GC-LSTM architecture}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Blockchain model verification ledger (Hyperledger Fabric). Each federation round stores the model hash (SHA-256), validation accuracy, and UTC timestamp in an immutable on-chain record. Post-incident forensics confirmed the deployed model at the time of the attack matched round-92 hash with 97.4\% validated accuracy—ruling out model tampering as an attack vector.}}{9}{figure.5}\protected@file@percent }
\newlabel{fig:blockchain}{{5}{9}{Blockchain model verification ledger (Hyperledger Fabric). Each federation round stores the model hash (SHA-256), validation accuracy, and UTC timestamp in an immutable on-chain record. Post-incident forensics confirmed the deployed model at the time of the attack matched round-92 hash with 97.4\% validated accuracy—ruling out model tampering as an attack vector}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Federated learning convergence. (a) GC-LSTM-BV converges in approximately 45 rounds (vs.\ 55+ for Fed-LSTM without graph structure), reaching 97.3\% accuracy. The centralized upper bound (gray dashed) is approached within 0.8\%. (b) Cumulative communication cost reaches 46.8\,GB at convergence—feasible for broadband-connected charging stations, and 98\% below equivalent centralized training data transfer.}}{10}{figure.6}\protected@file@percent }
\newlabel{fig:convergence}{{6}{10}{Federated learning convergence. (a) GC-LSTM-BV converges in approximately 45 rounds (vs.\ 55+ for Fed-LSTM without graph structure), reaching 97.3\% accuracy. The centralized upper bound (gray dashed) is approached within 0.8\%. (b) Cumulative communication cost reaches 46.8\,GB at convergence—feasible for broadband-connected charging stations, and 98\% below equivalent centralized training data transfer}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Cross-domain validation on UNSW-NB15. GC-LSTM-BV achieves 89.1\% zero-shot accuracy—4\% above Transformer-IDS—and rapidly recovers to 93.7\% with only 10\% fine-tuning labels, confirming that graph-topological inductive biases transfer across cyber-physical domains.}}{10}{figure.7}\protected@file@percent }
\newlabel{fig:crossdomain}{{7}{10}{Cross-domain validation on UNSW-NB15. GC-LSTM-BV achieves 89.1\% zero-shot accuracy—4\% above Transformer-IDS—and rapidly recovers to 93.7\% with only 10\% fine-tuning labels, confirming that graph-topological inductive biases transfer across cyber-physical domains}{figure.7}{}}
\@writefile{toc}{\contentsline {section}{\numberline {VII}Conclusion}{10}{section.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Adversarial robustness under white-box FGSM and PGD-10 attacks ($\epsilon _\text  {adv}=0.05$). GC-LSTM-BV suffers only $-$9.2\,pp degradation under PGD-10 vs.\ $-$11.6\,pp for Transformer-IDS, due to graph neighborhood aggregation that forces adversaries to corrupt all 100 neighboring EVs simultaneously.}}{10}{figure.8}\protected@file@percent }
\newlabel{fig:adversarial}{{8}{10}{Adversarial robustness under white-box FGSM and PGD-10 attacks ($\epsilon _\text {adv}=0.05$). GC-LSTM-BV suffers only $-$9.2\,pp degradation under PGD-10 vs.\ $-$11.6\,pp for Transformer-IDS, due to graph neighborhood aggregation that forces adversaries to corrupt all 100 neighboring EVs simultaneously}{figure.8}{}}
