\toprule
\textbf{Component} & \textbf{Annual (\$M)} & \textbf{15-yr NPV (\$M)} \\
\midrule
Energy arbitrage revenue & 0.56 & 8.4 \\
Curtailment avoidance value & 0.45 & 6.8 \\
Frequency regulation revenue & 0.13 & 1.9 \\
Carbon credit (\$75/t $\times$ 162\,kt) & 0.05 & 0.7 \\
\midrule
